# Active geocoding provider. One of: nominatim, ban
APP_GEOCODING_PROVIDER=ban

# Active weather/forecast provider. One of: open-meteo, met-norway
APP_WEATHER_PROVIDER=met-norway

# Nominatim (OpenStreetMap) geocoding API
APP_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# BAN (Base Adresse Nationale) geocoding API
APP_BAN_BASE_URL=https://api-adresse.data.gouv.fr

# Open-Meteo weather API
APP_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# MET Norway weather API
APP_MET_NORWAY_BASE_URL=https://api.met.no/weatherapi/locationforecast/2.0
APP_MET_NORWAY_USER_AGENT="WeatherApi/1.0 your-email@example.com"
